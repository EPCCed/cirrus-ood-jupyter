# Job submission configuration file
#
---

#
# Configure the content of the job script for the batch job here
# @see http://www.rubydoc.info/gems/ood_core/OodCore/BatchConnect/Template
#

<%-
  slurm_args = [
    "--hint=nomultithread",
    "--distribution=block:block",
    "--nodes", bc_num_slots.to_i.to_s, 
    "--ntasks-per-node", num_cores.to_i.to_s, 
    "--time", custom_walltime.to_s
  ]
-%>

<%-
  # 1. Path preparation
  # Expand shell shortcuts (like ~) and get absolute paths to avoid relative path errors
  expanded_path = `echo "#{venv_path}"`.strip
  parent_dir = `dirname "#{expanded_path}"`.strip

  # 2. State checks (Returns True/False)
  # We check the filesystem and convert the shell output directly into Ruby booleans
  dir_exists = `[[ -d "#{expanded_path}" ]] && echo 1 || echo 0`.strip == "1"
  is_valid_venv = `[[ -f "#{expanded_path}/bin/activate" ]] && echo 1 || echo 0`.strip == "1"
  has_jupyterlab = `[[ -f "#{expanded_path}/bin/jupyter-lab" ]] && echo 1 || echo 0`.strip == "1"
  parent_exists = `[[ -d "#{parent_dir}" ]] && echo 1 || echo 0`.strip == "1"
  can_write_parent = `[[ -w "#{parent_dir}" ]] && echo 1 || echo 0`.strip == "1"

  # 3. Validation logic
  
  # If user chose NOT to create a new environment, validate the existing one
  if create_venv.to_s == "0"
    if !dir_exists
      raise StandardError, "ERROR: The directory '#{expanded_path}' does not exist. Check the path or enable 'Create environment'."
    end

    if !is_valid_venv
      raise StandardError, "ERROR: '#{expanded_path}' is not a valid virtual environment (missing bin/activate)."
    end

    if !has_jupyterlab
      raise StandardError, "ERROR: JupyterLab is not installed in '#{expanded_path}'. Please install it manually or select 'Create environment'."
    end

  # If user chose TO CREATE a new environment, validate the parent location
  else
    if !parent_exists
      raise StandardError, "ERROR: Cannot create environment. The parent directory '#{parent_dir}' does not exist."
    end

    if !can_write_parent
      raise StandardError, "ERROR: Permission Denied. You do not have write access to '#{parent_dir}' to create an environment."
    end
  end
-%>

batch_connect:
  # We use the basic web server template for generating the job script
  #
  # @note Do not change this unless you know what you are doing!
  template: "basic"

  # You can override the command used to query the hostname of the compute node
  # here
  #
  # @note It is **highly** recommended this be set in the global cluster
  #   configuration file so that all apps can take advantage of it by default
  #
  #set_host: "host=$(hostname -A | awk '{print $2}')"

  #
  # Configure the job script submission parameters for the batch job here
  # @see http://www.rubydoc.info/gems/ood_core/OodCore/Job/Script
  #
  #script:
  #  queue_name: "queue1"
  #  accounting_id: "account1"
  #  email_on_started: true
  #  native: # ... array of command line arguments ...
  
script:
  native:
    <%- slurm_args.each do |arg| %>
    - "<%= arg %>"
    <%- end %>
    <%- if use_exclusive == "1" -%>
    - "--exclusive"
    <%- end -%>